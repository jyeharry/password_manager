<%= link_to "← Back", root_path, class: "mb-4 no-underline text-sm text-blue-500" %>
<div class="flex justify-between items-center mb-4">
  <h1 class='mb-0'>
    <%= @password.url %>
    <%= link_to @password.url, target: :blank do %>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-6 inline-block text-blue-500"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
        />
      </svg>
    <% end %>
  </h1>
  <%= link_to "Edit", edit_password_path if current_user_password.editable? %>
</div>

<h3>Credentials</h3>
<h6 class='text-xs mb-1'>Username / Email</h6>
<div class="flex gap-1 items-center mb-6">
  <pre class='mt-0 mb-0 grow'><code><%= @password.username %></code></pre>
  <%= button_tag "Copy",
  class: "px-5 py-2.5 bg-gray-200 rounded",
  data: {
    controller: "clipboard",
    action: "clipboard#copy",
    clipboard_content_value: @password.username,
  } %>
</div>

<h6 class='text-xs mb-1'>Password</h6>
<div class="flex gap-1 items-center mb-6">
  <pre class='mt-0 mb-0 grow'><code><%= @password.password %></code></pre>
  <%= button_tag "Copy",
  class: "px-5 py-2.5 bg-gray-200 rounded",
  data: {
    controller: "clipboard",
    action: "clipboard#copy",
    clipboard_content_value: @password.password,
  } %>
</div>

<h3>Share</h3>
<%= if current_user_password.shareable?
  link_to "Add a user", new_password_share_path(@password)
end %>

<ul class="not-prose mt-1 flex flex-col gap-1 divide-y divide-gray-100">
  <% @password.user_passwords.includes(:user).where.not(user: current_user).each do |user_password| %>
    <li class='flex justify-between items-center'>
      <span><%= user_password.user.email %></span>
      <span><%= user_password.role.capitalize %></span>
      <%= if current_user_password.deletable?
        button_to "Remove",
        password_share_path(@password, user_password.user),
        method: :delete,
        class: "cursor-pointer",
        data: {
          turbo_confirm: "Are you sure?",
        }
      end %>
    </li>
  <% end %>
</ul>
